PORT=3000
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

# Conexão direta PostgreSQL (opcional para execução de migrações DDL via script)
DATABASE_URL=postgresql://postgres:sua_senha@db.seu-projeto.supabase.co:5432/postgres

# Configurações da IA (Groq Cloud)
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=2500

# Fator de tortuosidade para cálculo de rotas geodésicas (padrão: 1.3)
ROUTING_TORTUOSITY_FACTOR=1.3

# Validação de CPF (definir como true apenas para testes e desenvolvimento offline)
SKIP_CPF_VALIDATION=false
