# URL base da API backend (necessário para deploy separado da API e Frontend)
# Em produção separada (ex: Vercel, Netlify, Cloudflare Pages ou S3): defina a URL pública da API
# Exemplo: VITE_API_URL=https://api.meusite.com
# Em desenvolvimento local sem proxy reverso:
VITE_API_URL=http://localhost:3000

# Alvo do proxy reverso de desenvolvimento do Vite (encaminha /api para o backend)
# Utilizado apenas ao rodar `npm run dev` localmente ou no Docker Compose
VITE_BACKEND_TARGET=http://localhost:3000
